<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Bloquear tráfico HTTP no seguro y restringir anclajes de confianza a certificados del sistema (protección contra MITM / proxies de usuario) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
