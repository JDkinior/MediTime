rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAssignedCaregiver(patientUid) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(patientUid)) && (
          get(/databases/$(database)/documents/users/$(patientUid)).data.get('caregiverUid', '') == request.auth.uid ||
          ('caregivers' in get(/databases/$(database)/documents/users/$(patientUid)).data &&
           request.auth.uid in get(/databases/$(database)/documents/users/$(patientUid)).data.caregivers)
        );
    }

    match /users/{userId} {
      // Bloquear acceso indiscriminado por ID: solo el dueño o el cuidador asignado pueden leer el perfil
      allow get: if isOwner(userId) || isAssignedCaregiver(userId);
      
      // Permitir búsqueda acotada a usuarios autenticados para vinculación de pacientes por email (máx. 5 resultados)
      allow list: if isAuthenticated() && request.query.limit <= 5;
      
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || (
        isAuthenticated() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caregiverUid', 'caregivers']) &&
        (
          request.resource.data.get('caregiverUid', null) == request.auth.uid ||
          (request.resource.data.get('caregiverUid', null) == null &&
           (resource.data.get('caregiverUid', '') == request.auth.uid ||
            ('caregivers' in resource.data && request.auth.uid in resource.data.caregivers)))
        )
      );
      
      allow delete: if isOwner(userId);

      match /managed_profiles/{profileId} {
        allow read, write: if isOwner(userId);

        match /userMedicamentos/{medicamentoId} {
          allow read, write: if isOwner(userId);
        }
      }

      match /chats/{chatId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /medicamentos/{userId} {
      allow read, write: if isOwner(userId) || isAssignedCaregiver(userId);

      match /userMedicamentos/{medicamentoId} {
        allow read, write: if isOwner(userId) || isAssignedCaregiver(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
